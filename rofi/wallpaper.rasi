/**
 * Rofi Theme - Matugen (warm)
 * Compatible with your colors.rasi
 */

/*****----- Configuration -----*****/
configuration {
    modi:                       "drun";
    show-icons:                 true;
    display-drun:               "";
    drun-display-format:        "{name}";
}

/*****----- Global Properties -----*****/
@import "colors.rasi"
@import "fonts.rasi"

/*****----- Main Window -----*****/
window {
    transparency:               "real";
    location:                   south;
    anchor:                     south;
    fullscreen:                 false;
    width:                      1000px;
    x-offset:                   0px;
    y-offset:                   0px;

    enabled:                    true;
    margin:                     0px;
    padding:                    0px;
    border:                     0px solid;
    border-radius:              10px 10px 0px 0px;
    border-color:               @on-secondary;
    background-color:           @surface;
    cursor:                     "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                    true;
    spacing:                    0px;
    margin:                     0px;
    padding:                    16px;
    border:                     0px solid;
    border-radius:              0px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                    true;
    spacing:                    0px;
    margin:                     0px 0px 12px 0px;
    padding:                    12px 14px;
    border:                     0px solid;
    border-radius:              10px;
    border-color:               @outline-variant;
    background-color:           @surface-container-high;
    text-color:                 @on-surface;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    background-color:           inherit;
    text-color:                 @primary;
}

entry {
    enabled:                    true;
    background-color:           inherit;
    text-color:                 @on-surface;
    cursor:                     text;
    placeholder:                "Wallpapers...";
    placeholder-color:          @on-surface-variant;
}

/*****----- Listview -----*****/
listview {
    enabled:                    true;
    columns:                    5;
    lines:                      1;
    cycle:                      false;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               false;
    fixed-columns:              false;

    spacing:                    6px;
    margin:                     0px;
    padding:                    4px 0px 0px 0px;
    background-color:           transparent;
    text-color:                 @on-surface;
    cursor:                     "default";
}

/*****----- Elements -----*****/
element {
    enabled:                    true;
    spacing:                    10px;
    margin:                     0px;
    padding:                    0px 10px 3px 10px;
    border:                     0px solid;
    border-radius:              8px;
    background-color:           transparent;
    text-color:                 @on-surface;
    orientation:                vertical;
    cursor:                     pointer;
}

element normal.normal {
    background-color:           transparent;
    text-color:                 @on-surface;
}

element selected.normal {
    background-color:           @primary;
    text-color:                 @on-primary;
}
element-icon selected.normal {
  size:                         250px; 
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       150px;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.5;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     inherit;
    vertical-align:             0.0;
    horizontal-align:           0.5;
}

/*****----- Message / Error -----*****/
error-message {
    padding:                    16px;
    border:                     2px solid;
    border-radius:              12px;
    border-color:               @error;
    background-color:           @surface;
    text-color:                 @on-surface;
}

textbox {
    background-color:           inherit;
    text-color:                 inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}
